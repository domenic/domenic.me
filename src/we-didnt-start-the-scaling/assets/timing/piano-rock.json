,"words":[[56,131],[131,152],[152,164],[164,209]]},{"sec":"V4","n":15,"text":"Ten days after \"pace\" \u2014 surprise!","start":149.364,"end":150.94,"words":[[34,54],[54,76],[76,112],[112,128],[128,134],[134,193]]},{"sec":"V4","n":16,"text":"Opus 5.5: \"Hi, guys!\"","start":150.922,"end":152.82,"words":[[37,73],[73,145],[145,173],[173,211]]},{"sec":"C4","n":1,"text":"We didn't start the scaling","start":152.869,"end":154.42,"words":[[16,24],[24,67],[67,109],[109,119],[119,269]]},{"sec":"C4","n":2,"text":"It was always training, and the curves kept gaining,","start":154.622,"end":158.64,"words":[[94,112],[112,134],[134,191],[191,255],[255,271],[271,287],[287,328],[328,364],[364,462]]},{"sec":"C4","n":3,"text":"We didn't start the scaling","start":158.71,"end":160.6,"words":[[53,71],[71,111],[111,150],[150,166],[166,307]]},{"sec":"C4","n":4,"text":"Now we swear we'll try to pace it \u2014 but we'd rather race it!","start":161.047,"end":164.86,"words":[[73,92],[92,100],[100,127],[127,135],[135,161],[161,189],[189,215],[215,224],[224,230],[230,251],[251,270],[270,315],[315,368],[368,443]]},{"sec":"C4","n":5,"text":"We didn't start the scaling","start":164.941,"end":166.8,"words":[[54,74],[74,109],[109,150],[150,165],[165,287]]},{"sec":"C4","n":6,"text":"But when we log off... will it still train on?","start":167.667,"end":171.56,"words":[[54,77],[77,101],[101,133],[133,175],[175,213],[213,235],[235,255],[255,299],[299,370],[370,522]]},{"sec":"outro","n":1,"text":"(And on, and on, and on\u2026)","start":172.146,"end":174.7,"words":[[74,96],[96,129],[129,155],[155,214],[214,227],[227,272]]}]}