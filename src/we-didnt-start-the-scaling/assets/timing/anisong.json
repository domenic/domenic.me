,"end":227.88,"words":[[46,122],[122,204],[204,284],[284,286],[286,354]]},{"sec":"V4","n":13,"text":"Trump: It's \"Super,\" by decree!","start":227.969,"end":230.4,"words":[[45,97],[97,119],[119,175],[175,231],[231,365]]},{"sec":"V4","n":14,"text":"\"Artificial\"? Fake to me!","start":231.424,"end":233.44,"words":[[20,122],[122,174],[174,194],[194,266]]},{"sec":"V4","n":15,"text":"Ten days after \"pace\" \u2014 surprise!","start":233.424,"end":236.32,"words":[[66,106],[106,174],[174,212],[212,264],[264,264],[264,384]]},{"sec":"V4","n":16,"text":"Opus 5.5: \"Hi, guys!\"","start":236.333,"end":239.48,"words":[[93,155],[155,269],[269,303],[303,363]]},{"sec":"C4","n":1,"text":"We didn't start the scaling","start":239.969,"end":241.18,"words":[[-1,15],[15,47],[47,69],[69,81],[81,169]]},{"sec":"C4","n":2,"text":"It was always training, and the curves kept gaining,","start":241.423,"end":244.18,"words":[[24,32],[32,58],[58,84],[84,168],[168,178],[178,192],[192,212],[212,234],[234,385]]},{"sec":"C4","n":3,"text":"We didn't start the scaling","start":245.06,"end":246.96,"words":[[68,88],[88,118],[118,142],[142,152],[152,216]]},{"sec":"C4","n":4,"text":"Now we swear we'll try to pace it \u2014 but we'd rather race it!","start":247.06,"end":251.2,"words":[[16,52],[52,80],[80,124],[124,140],[140,162],[162,174],[174,204],[204,214],[214,214],[214,232],[232,252],[252,398],[398,446],[446,452]]},{"sec":"C4","n":5,"text":"We didn't start the scaling","start":251.242,"end":255.48,"words":[[34,52],[52,84],[84,106],[106,118],[118,432]]},{"sec":"C4","n":6,"text":"But when we log off... will it still train on?","start":257.06,"end":264.26,"words":[[30,50],[50,70],[70,106],[106,208],[208,236],[304,334],[334,352],[352,394],[394,446],[446,814]]},{"sec":"outro","n":1,"text":"(And on, and on, and on\u2026)","start":265.787,"end":269.76,"words":[[-17,1],[1,41],[41,63],[63,81],[81,99],[99,405]]}]}