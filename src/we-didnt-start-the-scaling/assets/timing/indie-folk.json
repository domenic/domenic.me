],[306,354]]},{"sec":"V4","n":12,"text":"Chatbot nearly starts a war!","start":280.137,"end":283.38,"words":[[86,168],[168,224],[224,294],[294,310],[310,384]]},{"sec":"V4","n":13,"text":"Trump: It's \"Super,\" by decree!","start":283.329,"end":286.42,"words":[[65,121],[121,169],[169,218],[253,293],[293,339]]},{"sec":"V4","n":14,"text":"\"Artificial\"? Fake to me!","start":286.322,"end":289.7,"words":[[140,218],[272,312],[312,334],[334,360]]},{"sec":"V4","n":15,"text":"Ten days after \"pace\" \u2014 surprise!","start":289.713,"end":293.0,"words":[[53,97],[97,165],[165,215],[215,269],[301,301],[301,377]]},{"sec":"V4","n":16,"text":"Opus 5.5: \"Hi, guys!\"","start":292.905,"end":296.54,"words":[[116,164],[164,310],[310,352],[352,397]]},{"sec":"C4","n":1,"text":"We didn't start the scaling","start":297.693,"end":299.9,"words":[[81,99],[99,135],[135,161],[161,175],[175,431]]},{"sec":"C4","n":2,"text":"It was always training, and the curves kept gaining,","start":299.888,"end":306.5,"words":[[211,223],[223,257],[257,315],[315,481],[481,521],[521,539],[539,563],[563,601],[601,1067]]},{"sec":"C4","n":3,"text":"We didn't start the scaling","start":310.062,"end":312.9,"words":[[90,148],[148,180],[180,206],[206,218],[218,344]]},{"sec":"C4","n":4,"text":"Now we swear we'll try to pace it \u2014 but we'd rather race it!","start":313.055,"end":319.14,"words":[[44,105],[105,132],[132,175],[175,205],[205,238],[238,262],[262,325],[325,344],[443,443],[443,462],[462,488],[488,546],[546,602],[602,613]]},{"sec":"C4","n":5,"text":"We didn't start the scaling","start":320.237,"end":322.34,"words":[[70,90],[90,126],[126,158],[158,182],[182,264]]},{"sec":"C4","n":6,"text":"But when we log off... will it still train on?","start":322.631,"end":332.06,"words":[[161,183],[183,207],[207,243],[243,273],[273,302],[505,533],[533,547],[547,597],[597,667],[667,703]]},{"sec":"outro","n":1,"text":"(And on, and on, and on\u2026)","start":332.007,"end":335.38,"words":[[153,203],[203,217],[217,233],[233,2