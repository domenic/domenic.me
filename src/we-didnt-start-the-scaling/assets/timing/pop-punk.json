":150.06,"words":[[58,133],[133,157],[157,167],[167,213]]},{"sec":"V4","n":15,"text":"Ten days after \"pace\" \u2014 surprise!","start":150.129,"end":151.68,"words":[[33,56],[56,79],[79,113],[113,137],[137,143],[143,194]]},{"sec":"V4","n":16,"text":"Opus 5.5: \"Hi, guys!\"","start":151.729,"end":153.12,"words":[[34,73],[73,118],[118,132],[132,140]]},{"sec":"C4","n":1,"text":"We didn't start the scaling","start":153.129,"end":155.36,"words":[[0,7],[7,46],[46,175],[175,193],[193,292]]},{"sec":"C4","n":2,"text":"It was always training, and the curves kept gaining,","start":155.329,"end":159.46,"words":[[72,95],[95,116],[116,155],[155,239],[239,274],[274,293],[293,355],[355,397],[397,435]]},{"sec":"C4","n":3,"text":"We didn't start the scaling","start":159.529,"end":161.72,"words":[[15,22],[22,58],[58,173],[173,188],[188,292]]},{"sec":"C4","n":4,"text":"Now we swear we'll try to pace it \u2014 but we'd rather race it!","start":161.729,"end":166.06,"words":[[72,96],[96,113],[113,138],[138,151],[151,198],[198,215],[215,257],[257,275],[275,281],[281,295],[295,317],[317,374],[374,392],[392,417]]},{"sec":"C4","n":5,"text":"We didn't start the scaling","start":166.129,"end":168.06,"words":[[-23,8],[8,30],[30,157],[157,175],[175,297]]},{"sec":"C4","n":6,"text":"But when we log off... will it still train on?","start":168.129,"end":172.78,"words":[[97,117],[117,140],[140,178],[178,231],[231,277],[277,302],[302,323],[323,370],[370,420],[420,509]]},{"sec":"outro","n":1,"text":"(And on, and on, and on\u2026)","start":172.73,"end":176.22,"words":[[136,174],[174,220],[220,240],[240,295],[295,314],[314,383]]}]}