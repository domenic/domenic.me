.828,"end":155.0,"words":[[-5,71],[71,93],[93,105],[105,150]]},{"sec":"V4","n":15,"text":"Ten days after \"pace\" \u2014 surprise!","start":155.028,"end":156.64,"words":[[30,53],[53,75],[75,110],[110,126],[126,133],[133,194]]},{"sec":"V4","n":16,"text":"Opus 5.5: \"Hi, guys!\"","start":156.628,"end":158.58,"words":[[34,71],[71,150],[150,193],[193,250]]},{"sec":"C4","n":1,"text":"We didn't start the scaling","start":158.628,"end":160.7,"words":[[50,73],[73,101],[101,132],[132,138],[138,313]]},{"sec":"C4","n":2,"text":"It was always training, and the curves kept gaining,","start":162.027,"end":167.2,"words":[[36,76],[76,99],[99,136],[136,299],[337,354],[354,373],[373,416],[416,455],[455,676]]},{"sec":"C4","n":3,"text":"We didn't start the scaling","start":168.427,"end":170.0,"words":[[36,58],[58,87],[87,117],[117,130],[130,177]]},{"sec":"C4","n":4,"text":"Now we swear we'll try to pace it \u2014 but we'd rather race it!","start":170.026,"end":173.38,"words":[[17,32],[32,53],[53,76],[76,93],[93,115],[115,135],[135,162],[162,179],[179,185],[185,197],[197,214],[214,280],[280,322],[322,520]]},{"sec":"C4","n":5,"text":"We didn't start the scaling","start":173.826,"end":176.96,"words":[[140,151],[151,191],[191,220],[220,234],[234,497]]},{"sec":"C4","n":6,"text":"But when we log off... will it still train on?","start":178.426,"end":193.98,"words":[[37,53],[53,80],[80,98],[98,140],[140,359],[359,379],[379,391],[391,417],[417,481],[481,577]]},{"sec":"outro","n":1,"text":"(And on, and on, and on\u2026)","start":194.624,"end":198.56,"words":[[40,93],[93,202],[202,238],[238,363],[363,394],[394,438]]}]}