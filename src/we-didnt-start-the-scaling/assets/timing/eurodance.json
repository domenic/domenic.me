"end":182.92,"words":[[23,55],[55,71],[71,115],[115,135],[135,211]]},{"sec":"V4","n":14,"text":"\"Artificial\"? Fake to me!","start":183.39,"end":184.68,"words":[[19,87],[87,111],[111,123],[123,173]]},{"sec":"V4","n":15,"text":"Ten days after \"pace\" \u2014 surprise!","start":184.667,"end":186.52,"words":[[45,71],[71,99],[99,129],[129,149],[149,149],[149,221]]},{"sec":"V4","n":16,"text":"Opus 5.5: \"Hi, guys!\"","start":186.796,"end":189.1,"words":[[8,44],[44,176],[176,214],[214,311]]},{"sec":"C4","n":1,"text":"We didn't start the scaling","start":190.202,"end":192.14,"words":[[68,92],[92,124],[124,152],[152,164],[164,262]]},{"sec":"C4","n":2,"text":"It was always training, and the curves kept gaining,","start":192.33,"end":197.08,"words":[[49,65],[65,93],[93,125],[125,259],[259,275],[275,293],[293,377],[377,441],[441,527]]},{"sec":"C4","n":3,"text":"We didn't start the scaling","start":197.439,"end":198.76,"words":[[16,40],[40,76],[76,102],[102,116],[116,164]]},{"sec":"C4","n":4,"text":"Now we swear we'll try to pace it \u2014 but we'd rather race it!","start":198.716,"end":204.0,"words":[[36,58],[58,70],[70,94],[94,120],[120,146],[146,154],[154,202],[202,286],[286,286],[286,306],[306,330],[330,476],[476,548],[548,564]]},{"sec":"C4","n":5,"text":"We didn't start the scaling","start":204.038,"end":205.9,"words":[[32,54],[54,90],[90,118],[118,130],[130,406]]},{"sec":"C4","n":6,"text":"But when we log off... will it still train on?","start":207.443,"end":214.3,"words":[[66,86],[86,108],[108,130],[130,170],[170,232],[232,258],[258,270],[270,294],[294,414],[414,722]]},{"sec":"outro","n":1,"text":"(And on, and on, and on\u2026)","start":218.725,"end":222.5,"words":[[128,150],[150,252],[252,316],[316,418],[418,444],[444,752]]}]}