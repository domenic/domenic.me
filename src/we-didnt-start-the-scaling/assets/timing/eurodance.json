182.92,"words":[[23,53],[53,62],[62,115],[115,130],[130,202]]},{"sec":"V4","n":14,"text":"\"Artificial\"? Fake to me!","start":183.39,"end":184.68,"words":[[10,88],[88,112],[112,123],[123,173]]},{"sec":"V4","n":15,"text":"Ten days after \"pace\" \u2014 surprise!","start":184.667,"end":186.52,"words":[[45,70],[70,92],[92,129],[129,144],[144,153],[153,216]]},{"sec":"V4","n":16,"text":"Opus 5.5: \"Hi, guys!\"","start":186.796,"end":189.1,"words":[[3,44],[44,176],[176,214],[214,306]]},{"sec":"C4","n":1,"text":"We didn't start the scaling","start":190.202,"end":192.14,"words":[[65,90],[90,124],[124,150],[150,165],[165,257]]},{"sec":"C4","n":2,"text":"It was always training, and the curves kept gaining,","start":192.33,"end":197.08,"words":[[44,64],[64,86],[86,126],[126,254],[254,274],[274,290],[290,378],[378,442],[442,529]]},{"sec":"C4","n":3,"text":"We didn't start the scaling","start":197.439,"end":198.76,"words":[[18,39],[39,70],[70,102],[102,116],[116,164]]},{"sec":"C4","n":4,"text":"Now we swear we'll try to pace it \u2014 but we'd rather race it!","start":198.716,"end":204.0,"words":[[36,57],[57,72],[72,100],[100,120],[120,144],[144,158],[158,187],[187,286],[286,292],[292,307],[307,323],[323,475],[475,537],[537,558]]},{"sec":"C4","n":5,"text":"We didn't start the scaling","start":204.038,"end":205.9,"words":[[26,53],[53,84],[84,117],[117,129],[129,399]]},{"sec":"C4","n":6,"text":"But when we log off... will it still train on?","start":207.443,"end":214.3,"words":[[59,87],[87,108],[108,129],[129,152],[152,225],[225,256],[256,266],[266,291],[291,336],[336,361]]},{"sec":"outro","n":1,"text":"(And on, and on, and on\u2026)","start":218.725,"end":222.5,"words":[[128,150],[150,180],[252,266],[316,364],[418,444],[444,474]]}]}